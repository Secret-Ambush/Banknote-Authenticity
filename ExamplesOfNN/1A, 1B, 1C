import math

# Take number of inputs
n = int(input("Enter the number of input nodes: "))

# Take input values
x = []
print("Enter the input values:")
for i in range(n):
    val = float(input(f"x{i+1} = "))
    x.append(val)

# Take weight values
w = []
print("Enter the weight values:")
for i in range(n):
    wt = float(input(f"w{i+1} = "))
    w.append(wt)

# Take bias value
bias = float(input("Enter the bias value: "))

# Calculate net input (yin)
yin = sum([x[i] * w[i] for i in range(n)]) + bias
yin = round(yin, 3)

# Binary Sigmoidal Activation
def binary_sigmoid(yin):
    return round(1 / (1 + math.exp(-yin)), 3)

# Bipolar Sigmoidal Activation
def bipolar_sigmoid(yin):
    return round((2 / (1 + math.exp(-yin))) - 1, 3)

# Apply activation functions
binary_output = binary_sigmoid(yin)
bipolar_output = bipolar_sigmoid(yin)

# Display results
print("\n--- Results ---")
print("Inputs:", x)
print("Weights:", w)
print("Bias:", bias)
print("Net Input (yin):", yin)
print("Binary Sigmoidal Output:", binary_output)
print("Bipolar Sigmoidal Output:", bipolar_output)