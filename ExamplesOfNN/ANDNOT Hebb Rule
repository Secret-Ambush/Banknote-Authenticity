n=int(input("Enter the number of inputs="))
x1=[]
x2=[]

for i in range(0,n):
  ele1 = int(input())
  ele2 = int(input())
  x1.append(ele1)
  x2.append(ele2)

w1=0
w2=0
b=0

y=[-1,1,-1,-1]                #for ANDNOT Function

print("Input vector x1=",x1)
print("Input vector x2=",x2)
print("Target (y)=",y)

for i in range(0,n):
  w1=w1+x1[i]*y[i]
  w2=w2+x2[i]*y[i]
  b=b+y[i]

print("Final weights and bias:")
print("w1(new)=",w1)
print("w2(new)=",w2)
print("b(new)=",b)