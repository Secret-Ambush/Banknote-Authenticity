# Input values (binary logic: 1 = True, 0 = False)
A = 0
B = 1

# Logical operations
AND = A and B          # Logical AND
OR = A or B            # Logical OR
NOT_A = not A          # Logical NOT
XOR = (A and not B) or (not A and B)   # Logical XOR

# Display results
print("A =", A)
print("B =", B)
print("A AND B =", AND)
print("A OR B =", OR)
print("NOT A =", NOT_A)
print("A XOR B =", XOR)


